  "item": [
    {
      "name": "1. POST (Create)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status Code 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.environment.set(\"userId\", body._id);\r",
              "\r",
              "const requestBody = JSON.parse(pm.request.body.raw);\r",
              "pm.environment.set(\"email\", requestBody.email);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"Hora do QA - Aprenda em https://www.youtube.com/@horadoqa\",\r\n  \"email\": \"horadoqa.{{$randomUUID}}@qa.com.br\",\r\n  \"password\": \"1q2w3e4r\",\r\n  \"administrador\": \"true\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
